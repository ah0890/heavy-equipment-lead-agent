# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/heavy_equipment_leads

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json

# The ID of your Google Spreadsheet (from the URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ─── Facebook ────────────────────────────────────────────────────────────────
# Path where Playwright will save the FB session (so you log in only once)
FB_SESSION_FILE=credentials/fb_session.json

# Facebook email and password (used for first-time login only)
FB_EMAIL=your_facebook_email@example.com
FB_PASSWORD=your_facebook_password

# ─── Scraper Behaviour ───────────────────────────────────────────────────────
# Delay range between page actions (seconds). Mimics human browsing.
SCRAPER_MIN_DELAY=2
SCRAPER_MAX_DELAY=5

# Max listings to collect per keyword per city (set low for testing)
MAX_LISTINGS_PER_SEARCH=50

# ─── App Mode ────────────────────────────────────────────────────────────────
# "demo"     → uses mock data (no FB login needed)
# "facebook" → uses real Playwright + FB scraper
APP_MODE=demo

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
